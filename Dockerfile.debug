FROM ubuntu:24.04 AS build

RUN \
    apt-get update && \
    apt-get --no-install-recommends -y install \
      clang \
      libboost-dev \
      libboost-test-dev \
      libboost-system-dev \
      libc6 \
      libc6-dev \
      libstdc++6 \
      autoconf \
      automake \
      python3 \
      pkg-config \
      libffi-dev \
      libz-dev \
      xz-utils \
      git \
      cmake \
      make \
      ninja-build

ADD https://github.com/llvm/llvm-project/releases/download/llvmorg-18.1.3/llvm-18.1.3.src.tar.xz /
ADD https://github.com/llvm/llvm-project/releases/download/llvmorg-18.1.3/cmake-18.1.3.src.tar.xz /
ADD https://github.com/llvm/llvm-project/releases/download/llvmorg-18.1.3/third-party-18.1.3.src.tar.xz /

RUN \
    /bin/bash -c \
    "cd / && \
     tar xf llvm-18.1.3.src.tar.xz && \
     tar xf cmake-18.1.3.src.tar.xz && \
     mv /cmake-18.1.3.src /cmake && \
     tar xf third-party-18.1.3.src.tar.xz && \
     mv /third-party-18.1.3.src /third-party && \
     cmake -DCMAKE_INSTALL_PREFIX=/usr/local/ \
           -DCMAKE_BUILD_TYPE=MinSizeRel      \
           -DLLVM_TARGETS_TO_BUILD=""         \
           -DLLVM_LINK_LLVM_DYLIB=ON          \
           -DLLVM_ENABLE_ASSERTIONS=ON        \
           -DLLVM_ABI_BREAKING_CHECKS=FORCE_OFF \
           -GNinja                            \
           -S /llvm-18.1.3.src                \
           -B /build                       && \
     cmake --build /build && \
     cmake --install /build && \
     rm -r /build/ /llvm-18.1.3.src/ /cmake/ /third-party/ && \
     strip /usr/local/lib/libLLVM-18.so /usr/local/bin/llvm-link"

COPY . /nidhugg

RUN \
    /bin/bash -c \
    "cd /nidhugg && \
     autoreconf --install && \
     ./configure --prefix=/usr/local/ --enable-asserts CXXFLAGS='-Og -g' \
                LDFLAGS='-g -Wl,-rpath=/usr/local/lib/' && \
     make -Csrc -j$(nproc) nidhugg unittest && \
     make install && \
     install src/unittest /usr/local/bin/nidhugg-unittest && \
     strip /usr/local/bin/nidhugg-unittest"

FROM ubuntu:24.04
RUN \
    apt-get update && \
    apt-get --no-install-recommends -y install \
      clang \
      libboost-system1.83.0 \
      libboost-test1.83.0 \
      python3 \
      vim-tiny && \
    apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

COPY --from=build /usr/local/lib/libLLVM-18*.so /usr/local/lib/
COPY --from=build /usr/local/bin/llvm-link /usr/local/bin/
COPY --from=build /usr/local/bin/nidhugg* /usr/local/bin/
WORKDIR /root
